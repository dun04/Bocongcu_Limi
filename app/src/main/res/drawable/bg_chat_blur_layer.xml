<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền theo theme -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_dark" />
        </shape>
    </item>
    <!-- Quầng sáng Cyan Blur ở góc trên -->
    <item
        android:bottom="220dp"
        android:right="80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#3306B6D4"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Quầng sáng Blue Blur ở góc dưới -->
    <item
        android:top="220dp"
        android:left="80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="240dp"
                android:startColor="#3B3B82F6"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Quầng sáng tím Violet dịu nhẹ ở giữa -->
    <item
        android:top="140dp"
        android:bottom="140dp"
        android:left="40dp"
        android:right="40dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#228B5CF6"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
