<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp viền kính ngoài mờ tinh tế -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/frosted_glass_border" />
            <solid android:color="@color/frosted_glass_nav_color" />
        </shape>
    </item>

    <!-- Thân kính mờ Acrylic chuyển sắc mượt mà -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/nav_liquid_end"
                android:startColor="@color/nav_liquid_start"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
