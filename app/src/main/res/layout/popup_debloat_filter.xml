<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:contentPadding="0dp"
    app:strokeColor="@color/popup_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="5dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Lọc theo loại app"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="5dp"
            android:background="@color/card_stroke" />

        <!-- 1. Tất cả -->
        <LinearLayout
            android:id="@+id/itemFilterAll"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_theme_item_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Tất cả ứng dụng"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCheckFilterAll"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_line"
                app:tint="@color/primary" />
        </LinearLayout>

        <!-- 2. Bloatware rác -->
        <LinearLayout
            android:id="@+id/itemFilterBloatware"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_theme_item_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Bloatware rác gợi ý"
                android:textColor="#FF6900"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCheckFilterBloatware"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_line"
                android:visibility="invisible"
                app:tint="#FF6900" />
        </LinearLayout>

        <!-- 3. App Hệ Thống -->
        <LinearLayout
            android:id="@+id/itemFilterSystem"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_theme_item_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="App Hệ Thống (Lõi)"
                android:textColor="#FF4D4D"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCheckFilterSystem"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_line"
                android:visibility="invisible"
                app:tint="#FF4D4D" />
        </LinearLayout>

        <!-- 4. App Người Dùng -->
        <LinearLayout
            android:id="@+id/itemFilterUser"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@drawable/bg_theme_item_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Ứng dụng Người Dùng"
                android:textColor="#34D399"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCheckFilterUser"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_line"
                android:visibility="invisible"
                app:tint="#34D399" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
