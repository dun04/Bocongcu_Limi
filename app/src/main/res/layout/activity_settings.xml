<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top App Bar / Header (Bỏ nút quay lại) -->
    <LinearLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:minHeight="54dp"
        android:background="@color/bg_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cài đặt"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Icon lá cờ Việt Nam bên trái nút Themes (Kích thước 36dp x 36dp đồng bộ nút Themes) -->
        <ImageView
            android:id="@+id/ivFlagVietnam"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:contentDescription="Việt Nam"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_flag_vietnam" />

        <!-- Nút chọn Themes mở Popup dạng Pill tròn kính mờ hiển thị icon theme đang dùng -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemes"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text=""
            app:icon="@drawable/ic_theme_dark"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="18dp"
            app:iconTint="@color/text_primary"
            app:backgroundTint="@color/button_capsule_bg"
            app:cornerRadius="18dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <View
        android:id="@+id/settingsHeaderDivider"
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:layout_below="@id/settingsHeader"
        android:background="@color/card_stroke" />

    <!-- Nội dung cuộn tràn viền -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/settingsHeaderDivider"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ================= MỤC 1: FIX THÔNG BÁO XIAOMI & GIỚI THIỆU APP ================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Icon App mặc định khớp launcher -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/ic_launcher" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="LIMI"
                        android:textColor="@color/text_primary"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingsVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Phiên bản 1.1.3.1.ntd · Bộ công cụ LIMI"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.8dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/card_stroke" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="5dp"
                        android:text="Bộ công cụ LIMI là giải pháp toàn diện hỗ trợ tối ưu hóa hiệu năng, xử lý triệt để tình trạng chậm/mất thông báo và quản lý chuyên sâu hệ thống Xiaomi, Redmi, POCO (HyperOS &amp; MIUI).\n\n• Fix Thông Báo &amp; Hệ Thống: Bộ 15 lệnh tinh chỉnh chuyên sâu (FCM Heartbeat 120s, Millet Whitelist chống ngắt kết nối mạng, Doze Sleep, Wi-Fi Power Save), 7 lệnh Flagship và 6 lệnh hiệu chỉnh máy chủ NTP GPS Việt Nam.\n\n• Trợ Lý AI Limi: Tích hợp trí tuệ nhân tạo giải đáp kỹ thuật, tra cứu thông số hệ sinh thái Xiaomi và hướng dẫn tối ưu hệ thống thông minh.\n\n• Sức Khỏe Pin &amp; Phần Cứng: Đọc trực tiếp dữ liệu kernel phần cứng (chu kỳ sạc, dung lượng thực tế, tỷ lệ chai pin, nhiệt độ và điện áp thời gian thực).\n\n• Quản Lý &amp; Cấp Quyền Ứng Dụng: Cấp nhanh quyền Tự khởi chạy (Autostart), Pin không giới hạn, Pop-up và Hiển thị màn hình khóa cho các ứng dụng liên lạc và ngân hàng.\n\n• Dọn Dẹp Ứng Dụng Rác (Debloat): Vô hiệu hóa an toàn các dịch vụ theo dõi và quảng cáo hệ thống (MSA, Analytics, Mi Pay), hỗ trợ khôi phục nguyên bản.\n\n• Thực Thi Lệnh ADB Shell: Chạy câu lệnh hệ thống trực tiếp qua quyền Shizuku không cần kết nối máy tính.\n\n• Thông Tin Thiết Bị (My Device): Phân tích toàn diện 11 danh mục phần cứng và hệ điều hành theo thời gian thực.\n\n• Thiết Kế Tối Ưu: Giao diện phong cách HyperOS Dark OLED hiện đại, mượt mà và tối ưu năng lượng."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Nút Mở Cẩm Nang & Hướng Dẫn Khớp ảnh 1 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenGuideInSettings"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="14dp"
                        android:minHeight="42dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Xem cẩm nang &amp; lưu ý pin quan trọng"
                        android:textColor="@color/primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/nav_active_indicator_pill"
                        app:cornerRadius="21dp"
                        app:strokeColor="@color/nav_active_indicator_stroke"
                        app:strokeWidth="1dp" />

                    <!-- Nút Mở Video Hướng Dẫn (Google Drive) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenVideoGuide"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:minHeight="42dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Xem video hướng dẫn thao tác"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/button_capsule_bg"
                        app:cornerRadius="21dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp" />

                    <!-- Nút Kiểm Tra Cập Nhật Phiên Bản Mới (OTA) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckAppUpdate"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:minHeight="42dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Kiểm tra cập nhật phiên bản mới"
                        android:textColor="#38BDF8"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_cloud_sync"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="#38BDF8"
                        app:backgroundTint="#1F38BDF8"
                        app:cornerRadius="21dp"
                        app:strokeColor="#4D38BDF8"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= MỤC 2: 4 Ô XẾP HÌNH VUÔNG (GRID 2x2) ================= -->
            <!-- Hàng 1: Hoạt ảnh mở app + Phím tắt hệ thống -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <!-- Ô 1: Hoạt ảnh mở app -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSettingSplash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardBackgroundColor="@color/button_capsule_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_sparkles"
                                app:tint="@color/primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Hoạt ảnh app"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Video mở đầu 10s"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ô 2: Phím tắt hệ thống -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSettingShortcuts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardBackgroundColor="@color/button_capsule_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_shortcut"
                                app:tint="@color/primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Phím tắt Xiaomi"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Dev, Pin, Shizuku"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Hàng 2: Khôi phục mặc định + Thông tin nhà phát triển -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <!-- Ô 3: Khôi phục mặc định -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSettingReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardBackgroundColor="@color/button_capsule_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_reset_clock"
                                app:tint="@color/primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Khôi phục gốc"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Khôi phục Full lệnh app"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ô 4: Thông tin nhà phát triển -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSettingDeveloper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardBackgroundColor="@color/button_capsule_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_code_developer"
                                app:tint="@color/primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Nhà phát triển"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Zalo, Gmail"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= MỤC 3: THÔNG TIN THIẾT BỊ & TIẾN ĐỘ FIX (HÀNG 2 Ô DƯỚI 4 MỤC) ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <!-- Ô 1: My Device (Thông tin thiết bị) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMyDevice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardBackgroundColor="@color/button_capsule_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_device_info"
                                app:tint="@color/primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="My Device"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="11 danh mục phần cứng"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ô 2: Kiểm tra tiến độ Fix -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCheckFixProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:cardBackgroundColor="@color/button_capsule_bg"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_fix_check"
                                app:tint="@color/primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Tiến độ Fix"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Đo % hoàn thành"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar - Floating Pill Capsule Dock Với 5 Tabs -->
    <FrameLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/frosted_glass_nav_bg"
        android:elevation="8dp">

        <!-- Vùng chứa tọa độ chuẩn cho con nhộng và 5 tab -->
        <FrameLayout
            android:id="@+id/navTabsWrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp">

            <!-- Con nhộng nền trượt động (Sliding Pill Indicator) -->
            <View
                android:id="@+id/navIndicatorPill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav_active_pill"
                android:visibility="invisible" />

            <!-- 5 Tab đè lên trên với nền trong suốt -->
            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Tab 1: Fix hệ thống -->
                <LinearLayout
                    android:id="@+id/navTabSystem"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_item_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavSystem"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_system"
                        app:tint="@color/text_nav_inactive" />

                    <TextView
                        android:id="@+id/tvNavSystem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Fix Noti"
                        android:textColor="@color/text_nav_inactive"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Tab 2: Cấp quyền app -->
                <LinearLayout
                    android:id="@+id/navTabPermissions"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_item_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavPermissions"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_shield"
                        app:tint="@color/text_nav_inactive" />

                    <TextView
                        android:id="@+id/tvNavPermissions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Cấp quyền"
                        android:textColor="@color/text_nav_inactive"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Tab 3: Shell/ADB -->
                <LinearLayout
                    android:id="@+id/navTabCustom"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_item_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavCustom"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_add"
                        app:tint="@color/text_nav_inactive" />

                    <TextView
                        android:id="@+id/tvNavCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Shell/ADB"
                        android:textColor="@color/text_nav_inactive"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Tab 4: Debloat -->
                <LinearLayout
                    android:id="@+id/navTabDebloat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_item_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavDebloat"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_trash"
                        app:tint="@color/text_nav_inactive" />

                    <TextView
                        android:id="@+id/tvNavDebloat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Debloat"
                        android:textColor="@color/text_nav_inactive"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Tab 5: Cài đặt (Active) -->
                <LinearLayout
                    android:id="@+id/navTabSettings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_item_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivNavSettings"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_settings"
                        app:tint="@color/text_nav_active" />

                    <TextView
                        android:id="@+id/tvNavSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Cài đặt"
                        android:textColor="@color/text_nav_active"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

</RelativeLayout>
