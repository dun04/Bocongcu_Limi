<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_gravity="center"
  android:layout_margin="16dp"
  app:cardBackgroundColor="@color/surface_dark"
  app:cardCornerRadius="24dp"
  app:cardElevation="6dp"
  app:strokeColor="@color/popup_stroke"
  app:strokeWidth="1dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="18dp"
      android:paddingTop="18dp"
      android:paddingEnd="16dp"
      android:paddingBottom="14dp">

      <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_glass_pill"
        android:backgroundTint="@color/glass_shizuku_warn_bg">

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_shizuku_warning" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/tvShizukuDialogTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Yêu Cầu Quyền Shizuku"
          android:textColor="@color/text_primary"
          android:textSize="17sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="Thực thi lệnh ADB Shell không cần máy tính"
          android:textColor="@color/primary"
          android:textSize="11.5sp"
          android:textStyle="bold" />
      </LinearLayout>

      <ImageView
        android:id="@+id/btnCloseShizukuDialog"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_theme_item_inactive"
        android:clickable="true"
        android:focusable="true"
        android:padding="7dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="0.8dp"
      android:background="@color/card_stroke" />

    <!-- Message Body -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="18dp"
      android:paddingTop="16dp"
      android:paddingEnd="18dp"
      android:paddingBottom="14dp">

      <TextView
        android:id="@+id/tvShizukuDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_primary"
        android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Footer Buttons -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="18dp"
      android:paddingTop="4dp"
      android:paddingEnd="18dp"
      android:paddingBottom="18dp">

      <!-- Positive Action (Gradient Orange Button) -->
      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPositiveShizukuDialog"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="@null"
        android:background="@drawable/bg_btn_gradient_orange"
        android:text="Mở / Cấp quyền Shizuku"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:elevation="2dp" />

      <!-- Negative Button -->
      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNegativeShizukuDialog"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Đóng"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp"
        android:textStyle="bold"
        app:backgroundTint="@color/button_capsule_bg"
        app:cornerRadius="20dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp" />
    </LinearLayout>

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
