<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/cardAppDetailsRoot"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_gravity="center"
  android:layout_marginHorizontal="24dp"
  app:cardBackgroundColor="@color/card_bg"
  app:cardCornerRadius="24dp"
  app:cardElevation="6dp"
  app:strokeColor="@color/popup_stroke"
  app:strokeWidth="1dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: Icon, Tên App & Badge -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivDetailAppIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_default_app_icon"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/tvDetailAppName"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:singleLine="true"
          android:textColor="@color/text_primary"
          android:textSize="17sp"
          android:textStyle="bold"
          tools:text="Zalo" />

        <TextView
          android:id="@+id/tvDetailAppBadge"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:background="@drawable/badge_pill_bg"
          android:lines="1"
          android:maxLines="1"
          android:paddingStart="8dp"
          android:paddingTop="2dp"
          android:paddingEnd="8dp"
          android:paddingBottom="2dp"
          android:singleLine="true"
          android:textColor="@color/badge_chat_text"
          android:textSize="10.5sp"
          android:textStyle="bold"
          tools:text="Chat" />
      </LinearLayout>

    </LinearLayout>

    <!-- Khối Mô tả / Lưu ý về ứng dụng -->
    <LinearLayout
      android:id="@+id/containerDetailDesc"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:background="@drawable/bg_theme_item_inactive"
      android:orientation="vertical"
      android:padding="12dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="Mô tả &amp; Hướng dẫn:"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/tvDetailAppDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp"
        tools:text="Ứng dụng nhắn tin trực tuyến. Cần cấp quyền thông báo và chạy nền để nhận tin tức thì." />
    </LinearLayout>

    <!-- Box hiển thị Package Name + Nút Copy -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:background="@drawable/bg_code_box"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingTop="8dp"
      android:paddingEnd="8dp"
      android:paddingBottom="8dp">

      <TextView
        android:id="@+id/tvDetailPackageName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="com.zing.zalo" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyDetailPackage"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:contentDescription="Sao chép package"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@drawable/ic_content_copy"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="18dp"
        app:iconTint="@color/primary" />
    </LinearLayout>

    <!-- Divider mờ -->
    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="16dp"
      android:layout_marginBottom="14dp"
      android:background="@color/card_stroke" />

    <!-- Nút hành động: Xem thông tin & Đóng -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical|end"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDetailClose"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:text="Đóng"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp"
        app:cornerRadius="14dp" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenAppInfoSettings"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:backgroundTint="@color/primary"
        android:text="Xem cài đặt"
        android:textColor="@color/on_primary"
        android:textSize="12.5sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />
    </LinearLayout>

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
