<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDialogDeveloperRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/popup_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Icon, Tiêu đề & Nút đóng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="#15FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#25FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_code_developer"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thông tin nhà phát triển"
                    android:textColor="@color/text_primary"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Bộ công cụ LIMI · Developed by Dung Nguyen"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogDevClose"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_close_white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/text_secondary" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="@color/card_stroke" />

        <!-- Box mô tả -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_code_box"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="Tham gia cộng đồng người dùng Xiaomi / HyperOS để được hỗ trợ kỹ thuật, cập nhật các bản vá mới nhất và đóng góp ý kiến cải tiến ứng dụng."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Nút Ủng hộ nhà phát triển -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogDonateDeveloper"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:minHeight="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="☕  Ủng hộ nhà phát triển (Donate)"
            android:textColor="#F59E0B"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#1F1A0F"
            app:cornerRadius="22dp"
            app:strokeColor="#78350F"
            app:strokeWidth="1dp" />

        <!-- Nút Zalo -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogJoinZaloGroup"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:minHeight="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="💬  Tham gia nhóm Zalo hỗ trợ"
            android:textColor="#60A5FA"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#0F1F30"
            app:cornerRadius="22dp"
            app:strokeColor="#1D3E66"
            app:strokeWidth="1dp" />

        <!-- Nút Gmail -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogContactGmail"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:minHeight="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="✉  duyih122@gmail.com"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/button_capsule_bg"
            app:cornerRadius="22dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
