<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingEnd="12dp"
  android:paddingTop="6dp"
  android:paddingBottom="6dp">

  <!-- USER MESSAGE -->
  <LinearLayout
    android:id="@+id/layoutUserMessage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:visibility="visible">

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxWidth="280dp"
      android:background="@drawable/bg_chat_bubble_user"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:paddingTop="10dp"
      android:paddingBottom="10dp"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvUserMessageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:lineSpacingExtra="3dp"
        android:text="Tôi muốn hỏi về cách fix thông báo Zalo" />

      <TextView
        android:id="@+id/tvUserTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="3dp"
        android:textColor="#FFEDD5"
        android:textSize="9.5sp"
        android:text="23:15" />
    </LinearLayout>
  </LinearLayout>

  <!-- LIMI AI MESSAGE -->
  <LinearLayout
    android:id="@+id/layoutLimiMessage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:visibility="gone">

    <!-- Avatar Limi AI Logo App -->
    <com.google.android.material.card.MaterialCardView
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:layout_marginEnd="8dp"
      app:cardBackgroundColor="#0D1117"
      app:cardCornerRadius="16dp"
      app:cardElevation="0dp"
      app:strokeWidth="0dp">

      <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/app_icon" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxWidth="300dp"
      android:background="@drawable/bg_chat_bubble_limi"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:paddingTop="10dp"
      android:paddingBottom="10dp"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Trợ lý Limi"
          android:textColor="#60A5FA"
          android:textSize="11.5sp"
          android:textStyle="bold" />

        <ImageView
          android:id="@+id/btnCopyAiMessage"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:padding="2dp"
          android:src="@drawable/ic_content_copy"
          android:background="?attr/selectableItemBackgroundBorderless"
          app:tint="#94A3B8" />
      </LinearLayout>

      <TextView
        android:id="@+id/tvLimiMessageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E2E8F0"
        android:textSize="13.5sp"
        android:lineSpacingExtra="3.5dp"
        android:textIsSelectable="true"
        android:text="Chào bạn, mình là Limi! Để fix Zalo, bạn hãy..." />

      <TextView
        android:id="@+id/tvLimiTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:textColor="#64748B"
        android:textSize="9.5sp"
        android:text="23:15" />
    </LinearLayout>
  </LinearLayout>

</LinearLayout>
