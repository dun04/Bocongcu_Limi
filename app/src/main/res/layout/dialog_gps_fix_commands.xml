<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_gravity="center"
  android:layout_margin="14dp"
  app:cardBackgroundColor="@color/surface_dark"
  app:cardCornerRadius="24dp"
  app:cardElevation="6dp"
  app:strokeColor="@color/popup_stroke"
  app:strokeWidth="1dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header: GPS Location HyperOS Style -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="18dp"
      android:paddingTop="16dp"
      android:paddingEnd="16dp"
      android:paddingBottom="14dp">

      <!-- App Icon Badge -->
      <com.google.android.material.card.MaterialCardView
        android:layout_width="38dp"
        android:layout_height="38dp"
        app:cardBackgroundColor="@color/button_capsule_bg"
        app:cardCornerRadius="19dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
          android:id="@+id/ivGpsIcon"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="centerCrop"
          android:src="@drawable/app_icon" />
      </com.google.android.material.card.MaterialCardView>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TỐI ƯU ĐỊNH VỊ GPS"
            android:textColor="@color/text_primary"
            android:textSize="15.5sp"
            android:textStyle="bold" />

          <!-- Lá cờ Việt Nam đỏ sao vàng -->
          <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_flag_vietnam" />
        </LinearLayout>

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="Fix lệch bản đồ, bắt vệ tinh chậm &amp; mất sóng GPS"
          android:textColor="@color/text_secondary"
          android:textSize="11.5sp" />
      </LinearLayout>

      <ImageView
        android:id="@+id/btnCloseGpsDialog"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_theme_item_inactive"
        android:clickable="true"
        android:focusable="true"
        android:padding="7dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@color/card_stroke" />

    <!-- Cuộn nội dung danh sách lệnh Fix GPS -->
    <androidx.core.widget.NestedScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:maxHeight="360dp"
      android:overScrollMode="never"
      android:descendantFocusability="blocksDescendants"
      android:scrollbars="vertical">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Alert Box: Giải thích nguyên nhân & hiệu quả -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="14dp"
          android:background="@drawable/bg_glass_card"
          android:orientation="vertical"
          android:padding="12dp">

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vì sao nên chạy bộ lệnh này tại Việt Nam?"
            android:textColor="@color/primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="Máy Xiaomi xách tay / nội địa thường kết nối NTP máy chủ Trung Quốc khiến việc đồng bộ đồng hồ vệ tinh bị lệch mili-giây, dẫn đến Google Maps và Grab bị nhảy vị trí. Bộ lệnh này cấu hình máy chủ NTP Việt Nam (vn.pool.ntp.org), bật A-GPS và chống Doze bóp chip định vị."
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />
        </LinearLayout>

        <!-- LỆNH GPS 1 -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardBackgroundColor="@color/glass_card_bg"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/card_stroke"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_bg"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="LỆNH 1 · NTP VIỆT NAM"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Đồng Bộ NTP Server VN"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            </LinearLayout>

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="Chuyển máy chủ thời gian về vn.pool.ntp.org để chip GPS đồng bộ nano-giây với trạm mặt đất, khóa vệ tinh tức thì trong 1-2s."
              android:textColor="@color/text_secondary"
              android:textSize="11.5sp" />

            <!-- Code box -->
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:background="@drawable/bg_code_box"
              android:fontFamily="monospace"
              android:padding="8dp"
              android:text="settings put global ntp_server vn.pool.ntp.org; settings put global ntp_timeout 5000"
              android:textColor="@color/primary"
              android:textSize="11sp" />

            <!-- Nút Thao tác Icon giống các trang khác -->
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:gravity="end"
              android:orientation="horizontal">

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyGpsCmd1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp" />

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunGpsCmd1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/nav_active_indicator_pill"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/nav_active_indicator_stroke"
                app:strokeWidth="1dp" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LỆNH GPS 2 -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardBackgroundColor="@color/glass_card_bg"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/card_stroke"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_bg"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="LỆNH 2 · A-GPS / SUPL"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Bật A-GPS &amp; High Accuracy"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            </LinearLayout>

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="Kích hoạt assisted_gps_enabled và cho phép kết hợp tọa độ vệ tinh GPS + Trạm phát sóng mạng di động 4G/5G."
              android:textColor="@color/text_secondary"
              android:textSize="11.5sp" />

            <!-- Code box -->
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:background="@drawable/bg_code_box"
              android:fontFamily="monospace"
              android:padding="8dp"
              android:text="settings put global assisted_gps_enabled 1; settings put secure location_mode 3"
              android:textColor="@color/primary"
              android:textSize="11sp" />

            <!-- Nút Thao tác Icon -->
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:gravity="end"
              android:orientation="horizontal">

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyGpsCmd2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp" />

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunGpsCmd2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/nav_active_indicator_pill"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/nav_active_indicator_stroke"
                app:strokeWidth="1dp" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LỆNH GPS 3 -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardBackgroundColor="@color/glass_card_bg"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/card_stroke"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_bg"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="LỆNH 3 · GMS LOCATION"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Tối Ưu Quyền Cho GMS"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            </LinearLayout>

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="Cấp quyền FINE_LOCATION và MONITOR_HIGH_POWER_LOCATION giúp Google Maps định vị mượt mà khi di chuyển tốc độ cao."
              android:textColor="@color/text_secondary"
              android:textSize="11.5sp" />

            <!-- Code box -->
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:background="@drawable/bg_code_box"
              android:fontFamily="monospace"
              android:padding="8dp"
              android:text="cmd appops set com.google.android.gms FINE_LOCATION allow"
              android:textColor="@color/primary"
              android:textSize="11sp" />

            <!-- Nút Thao tác Icon -->
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:gravity="end"
              android:orientation="horizontal">

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyGpsCmd3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp" />

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunGpsCmd3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/nav_active_indicator_pill"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/nav_active_indicator_stroke"
                app:strokeWidth="1dp" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LỆNH GPS 4 -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardBackgroundColor="@color/glass_card_bg"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/card_stroke"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_bg"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="LỆNH 4 · FUSED LOCATION"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Chống Bóp Fused Location"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            </LinearLayout>

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="Đưa bộ điều phối vị trí vào Doze whitelist và cho phép RUN_IN_BACKGROUND không bị HyperOS ngắt khi tắt màn hình."
              android:textColor="@color/text_secondary"
              android:textSize="11.5sp" />

            <!-- Code box -->
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:background="@drawable/bg_code_box"
              android:fontFamily="monospace"
              android:padding="8dp"
              android:text="dumpsys deviceidle whitelist +com.android.location.fused"
              android:textColor="@color/primary"
              android:textSize="11sp" />

            <!-- Nút Thao tác Icon -->
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:gravity="end"
              android:orientation="horizontal">

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyGpsCmd4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp" />

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunGpsCmd4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/nav_active_indicator_pill"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/nav_active_indicator_stroke"
                app:strokeWidth="1dp" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LỆNH GPS 5 -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardBackgroundColor="@color/glass_card_bg"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/card_stroke"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_bg"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="LỆNH 5 · INDOOR SCAN"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Quét Wi-Fi / BLE Trong Nhà"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            </LinearLayout>

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="Bật quét Wi-Fi và BLE ngầm để định vị chính xác khi đi vào hầm gửi xe, trung tâm thương mại hoặc nhà cao tầng."
              android:textColor="@color/text_secondary"
              android:textSize="11.5sp" />

            <!-- Code box -->
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:background="@drawable/bg_code_box"
              android:fontFamily="monospace"
              android:padding="8dp"
              android:text="settings put global wifi_scan_always_enabled 1; settings put global ble_scan_always_enabled 1"
              android:textColor="@color/primary"
              android:textSize="11sp" />

            <!-- Nút Thao tác Icon -->
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:gravity="end"
              android:orientation="horizontal">

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyGpsCmd5"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp" />

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunGpsCmd5"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/nav_active_indicator_pill"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/nav_active_indicator_stroke"
                app:strokeWidth="1dp" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LỆNH GPS 6 -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardBackgroundColor="@color/glass_card_bg"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/card_stroke"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_bg"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="LỆNH 6 · XTRA / REFRESH"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Làm Mới Chip GPS / XTRA"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            </LinearLayout>

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="Phát broadcast làm mới chip GPS, xóa cache vệ tinh cũ và nạp lại toàn bộ dữ liệu quỹ đạo GPS, GLONASS, BeiDou, Galileo."
              android:textColor="@color/text_secondary"
              android:textSize="11.5sp" />

            <!-- Code box -->
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:background="@drawable/bg_code_box"
              android:fontFamily="monospace"
              android:padding="8dp"
              android:text="am broadcast -a android.location.GPS_ENABLED_CHANGE --ez enabled true"
              android:textColor="@color/primary"
              android:textSize="11sp" />

            <!-- Nút Thao tác Icon -->
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:gravity="end"
              android:orientation="horizontal">

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyGpsCmd6"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp" />

              <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunGpsCmd6"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/nav_active_indicator_pill"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/nav_active_indicator_stroke"
                app:strokeWidth="1dp" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

      </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@color/card_stroke" />

    <!-- Footer Action Buttons: Chạy toàn bộ & Sao chép tất cả dạng Dọc lớn không bị che khuất -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingTop="12dp"
      android:paddingEnd="16dp"
      android:paddingBottom="16dp">

      <!-- Nút Chạy Toàn Bộ 6 Lệnh dạng Button cam gradient giống nút chính -->
      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRunAllGpsCommands"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:minHeight="50dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="@null"
        android:background="@drawable/bg_btn_gradient_orange"
        android:text="Chạy toàn bộ 6 lệnh Fix GPS"
        android:textColor="@color/on_primary"
        android:textSize="14.5sp"
        android:textStyle="bold"
        app:cornerRadius="25dp"
        app:elevation="3dp"
        app:icon="@drawable/ic_play_arrow"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="18dp"
        app:iconTint="@color/on_primary" />

      <!-- Nút Sao Chép Toàn Bộ Lệnh dạng Tonal Button -->
      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyAllGpsCommands"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:minHeight="42dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Sao chép toàn bộ lệnh ADB"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@color/button_capsule_bg"
        app:cornerRadius="21dp"
        app:icon="@drawable/ic_content_copy"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="17dp"
        app:iconTint="@color/text_primary"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp" />
    </LinearLayout>

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
