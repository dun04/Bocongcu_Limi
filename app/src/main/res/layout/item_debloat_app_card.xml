<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="8dp"
  app:cardBackgroundColor="@color/card_bg"
  app:cardCornerRadius="18dp"
  app:cardElevation="0dp"
  app:strokeColor="@color/card_stroke"
  app:strokeWidth="1dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Checkbox chọn app gọn gàng -->
    <com.google.android.material.checkbox.MaterialCheckBox
      android:id="@+id/cbSelectDebloat"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minWidth="0dp"
      android:minHeight="0dp"
      app:buttonTint="@color/primary" />

    <!-- Icon app thực tế bo góc squircle 10dp giống hệt trang Cấp Quyền -->
    <com.google.android.material.imageview.ShapeableImageView
      android:id="@+id/ivDebloatAppIcon"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:layout_marginStart="8dp"
      android:scaleType="centerCrop"
      android:src="@drawable/ic_default_app_icon"
      app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

    <!-- Thông tin App + Nhãn phân loại -->
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <!-- Hàng Tên App + Badge loại app (Hệ thống màu ĐỎ) -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/tvDebloatAppName"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="1"
          android:singleLine="true"
          android:textColor="@color/text_primary"
          android:textSize="14sp"
          android:textStyle="bold"
          tools:text="MIUI Analytics" />

        <!-- Badge Loại App: Màu ĐỎ nếu là Hệ Thống, không bao giờ bị rớt dòng -->
        <TextView
          android:id="@+id/tvDebloatBadge"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:background="@drawable/badge_pill_bg"
          android:backgroundTint="#26FF4D4D"
          android:lines="1"
          android:maxLines="1"
          android:paddingStart="6dp"
          android:paddingTop="1.5dp"
          android:paddingEnd="6dp"
          android:paddingBottom="1.5dp"
          android:singleLine="true"
          android:text="Hệ Thống"
          android:textColor="#FF4D4D"
          android:textSize="9.5sp"
          android:textStyle="bold" />
      </LinearLayout>

      <!-- Package Name -->
      <TextView
        android:id="@+id/tvDebloatPackageName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="com.miui.analytics" />

      <!-- Gợi ý mô tả CHỈ hiện với Bloatware rác đã biết -->
      <TextView
        android:id="@+id/tvDebloatDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#FF6900"
        android:textSize="10.5sp"
        android:visibility="gone"
        tools:text="Quảng cáo &amp; thu thập dữ liệu ngầm" />
    </LinearLayout>

    <!-- Nút Gỡ nhanh 1 app -->
    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnQuickUninstall"
      style="@style/Widget.Material3.Button.TonalButton"
      android:layout_width="wrap_content"
      android:layout_height="32dp"
      android:layout_marginStart="8dp"
      android:minWidth="0dp"
      android:minHeight="32dp"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:insetLeft="0dp"
      android:insetRight="0dp"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:text="Gỡ"
      android:textColor="#FF4D4D"
      android:textSize="11sp"
      android:textStyle="bold"
      app:backgroundTint="#1FFF4D4D"
      app:cornerRadius="16dp"
      app:strokeColor="#33FF4D4D"
      app:strokeWidth="1dp" />

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
