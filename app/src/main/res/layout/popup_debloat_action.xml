<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  app:cardBackgroundColor="@color/card_bg"
  app:cardCornerRadius="16dp"
  app:cardElevation="6dp"
  app:contentPadding="0dp"
  app:strokeColor="@color/popup_stroke"
  app:strokeWidth="1dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:paddingTop="2dp"
      android:paddingBottom="5dp"
      android:singleLine="true"
      android:ellipsize="end"
      android:text="Thao tác Debloat máy"
      android:textColor="@color/primary"
      android:textSize="12sp"
      android:textStyle="bold" />

    <View
      android:layout_width="match_parent"
      android:layout_height="0.8dp"
      android:layout_marginStart="2dp"
      android:layout_marginEnd="2dp"
      android:layout_marginBottom="5dp"
      android:background="@color/card_stroke" />

    <!-- 1. Gỡ bỏ đã chọn -->
    <LinearLayout
      android:id="@+id/itemActionUninstall"
      android:layout_width="match_parent"
      android:layout_height="32dp"
      android:layout_marginBottom="3dp"
      android:background="@drawable/bg_theme_item_inactive"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingEnd="8dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Gỡ bỏ app đã chọn"
        android:textColor="#FF4D4D"
        android:textSize="11.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Tắt / Disable -->
    <LinearLayout
      android:id="@+id/itemActionDisable"
      android:layout_width="match_parent"
      android:layout_height="32dp"
      android:layout_marginBottom="3dp"
      android:background="@drawable/bg_theme_item_inactive"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingEnd="8dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Vô hiệu hóa (Tắt app)"
        android:textColor="@color/primary"
        android:textSize="11.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Khôi phục / Cài lại app -->
    <LinearLayout
      android:id="@+id/itemActionRestore"
      android:layout_width="match_parent"
      android:layout_height="32dp"
      android:layout_marginBottom="3dp"
      android:background="@drawable/bg_theme_item_inactive"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingEnd="8dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Khôi phục (Cài lại app)"
        android:textColor="#34D399"
        android:textSize="11.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="0.8dp"
      android:layout_marginStart="2dp"
      android:layout_marginTop="2dp"
      android:layout_marginEnd="2dp"
      android:layout_marginBottom="5dp"
      android:background="@color/card_stroke" />

    <!-- 4. Tự chọn Bloatware -->
    <LinearLayout
      android:id="@+id/itemActionSelectBloatware"
      android:layout_width="match_parent"
      android:layout_height="32dp"
      android:layout_marginBottom="3dp"
      android:background="@drawable/bg_theme_item_inactive"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingEnd="8dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Tự chọn Bloatware rác"
        android:textColor="#FF6900"
        android:textSize="11.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. Bỏ chọn tất cả -->
    <LinearLayout
      android:id="@+id/itemActionUnselectAll"
      android:layout_width="match_parent"
      android:layout_height="32dp"
      android:background="@drawable/bg_theme_item_inactive"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingEnd="8dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Bỏ chọn tất cả"
        android:textColor="@color/text_secondary"
        android:textSize="11.5sp"
        android:textStyle="bold" />
    </LinearLayout>

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
