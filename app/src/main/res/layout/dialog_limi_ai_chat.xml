<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/cardLimiChatContainer"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@android:color/transparent">

    <!-- LỚP HIỆU ỨNG BLUR / QUẦNG SÁNG KÍNH MỜ BÊN TRONG KHUNG CHAT -->
    <View
      android:id="@+id/viewChatBlurBackground"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@drawable/bg_chat_blur_layer" />

    <!-- NỘI DUNG CHAT CHÍNH -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical">

      <!-- HEADER FROSTED GLASS (Nền trong suốt đồng nhất với nền Aurora) -->
      <LinearLayout
        android:id="@+id/layoutLimiChatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/transparent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Avatar Logo App LIMI -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:layout_marginEnd="12dp"
          app:cardBackgroundColor="@color/button_capsule_bg"
          app:cardCornerRadius="19dp"
          app:cardElevation="0dp"
          app:strokeWidth="0dp">

          <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/app_icon" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trợ lý AI LIMI"
            android:textColor="@color/text_primary"
            android:textSize="15.5sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/tvAiStatusSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Chuyên gia Tối ưu &amp; Fix Thông Báo Xiaomi"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
        </LinearLayout>

        <!-- Nút Kho Tri Thức / Đồng Bộ Drive (Đã tự động hóa hoàn toàn khi mở app/chat) -->
        <ImageView
          android:id="@+id/btnAiKnowledge"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:layout_marginEnd="8dp"
          android:padding="6dp"
          android:src="@drawable/ic_cloud_sync"
          android:background="@drawable/bg_circle_button"
          android:visibility="gone"
          app:tint="@color/primary" />

        <!-- Nút Xóa Lịch Sử Chat -->
        <ImageView
          android:id="@+id/btnAiClearChat"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:layout_marginEnd="8dp"
          android:padding="7dp"
          android:src="@drawable/ic_refresh"
          android:background="?attr/selectableItemBackgroundBorderless"
          app:tint="@color/text_secondary" />


        <!-- Nút Đóng -->
        <ImageView
          android:id="@+id/btnAiChatClose"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:padding="8dp"
          android:src="@drawable/ic_close_white"
          android:background="?attr/selectableItemBackgroundBorderless"
          app:tint="@color/text_secondary" />
      </LinearLayout>

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

      <!-- KHU VỰC CHAT VÀ OVERLAY -->
      <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- DANH SÁCH TIN NHẮN -->
        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvLimiChatMessages"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:clipToPadding="false"
          android:clipChildren="false"
          android:descendantFocusability="beforeDescendants"
          android:paddingTop="8dp"
          android:paddingBottom="60dp"
          android:scrollbars="vertical" />

        <!-- VÙNG OVERLAY NẰM TRÊN DANH SÁCH TIN NHẮN -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_alignParentBottom="true"
          android:orientation="vertical"
          android:gravity="bottom">

          <!-- ĐANG TRẢ LỜI / TYPING INDICATOR -->
          <LinearLayout
            android:id="@+id/layoutLimiTyping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_glass_pill"
            android:paddingStart="10dp"
            android:paddingEnd="16dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <com.xiaomi.fixnotification.ai.ThinkingOrbView
              android:id="@+id/orbLimiTyping"
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_marginEnd="8dp" />

            <TextView
              android:id="@+id/tvLimiTyping"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Limi đang suy nghĩ và phản hồi..."
              android:textColor="@color/text_primary"
              android:textSize="12sp"
              android:textStyle="normal" />
          </LinearLayout>

          <!-- THANH XEM TRƯỚC ẢNH ĐÍNH KÈM (Tối đa 5 ảnh) -->
          <LinearLayout
            android:id="@+id/layoutSelectedImagePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <HorizontalScrollView
              android:id="@+id/scrollChatSelectedImages"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:scrollbars="none">

              <LinearLayout
                android:id="@+id/layoutChatSelectedImagesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
            </HorizontalScrollView>
          </LinearLayout>

          <!-- CÂU HỎI GỢI Ý NHANH (QUICK CHIPS) -->
          <HorizontalScrollView
            android:id="@+id/layoutPromptChipsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:background="@android:color/transparent"
            android:visibility="gone">

            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal">

              <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAiPrompt1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Fix trễ thông báo Zalo / Tele"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:rippleColor="?attr/colorControlHighlight" />

              <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAiPrompt2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Lệnh 4 Millet là gì?"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:rippleColor="?attr/colorControlHighlight" />

              <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAiPrompt3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Hướng dẫn kích hoạt Shizuku"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:rippleColor="?attr/colorControlHighlight" />

              <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAiPrompt4"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Tối ưu pin &amp; không nóng máy"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:rippleColor="?attr/colorControlHighlight" />

              <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAiPrompt5"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Gỡ ứng dụng nào an toàn?"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/button_capsule_bg"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:rippleColor="?attr/colorControlHighlight" />

            </LinearLayout>
          </HorizontalScrollView>

        </LinearLayout>
      </RelativeLayout>

      <!-- KHUNG NHẬP TIN NHẮN FROSTED GLASS (Nền trong suốt đồng nhất với nền Aurora) -->
      <LinearLayout
        android:id="@+id/layoutLimiChatInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@android:color/transparent"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- Nút Mũi Tên Bật/Tắt Hàng Gợi Ý Câu Hỏi (Ở bên trái icon nhập ảnh, hoàn toàn không có màu nền) -->
        <ImageView
          android:id="@+id/btnTogglePromptChips"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:layout_marginEnd="3dp"
          android:padding="6dp"
          android:src="@drawable/ic_arrow_up"
          android:background="@android:color/transparent"
          android:contentDescription="Bật/tắt gợi ý câu hỏi"
          app:tint="@color/text_secondary"
          android:clickable="true"
          android:focusable="true" />

        <!-- Nút đính kèm (+) trên thanh nhập liệu - KÍCH THƯỚC CỐ ĐỊNH 38dp x 38dp KHÔNG ĐẨY Ô CHAT -->
        <FrameLayout
          android:id="@+id/btnGooeyAttachAnchor"
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:layout_marginEnd="6dp"
          android:background="@drawable/bg_circle_button"
          android:clickable="true"
          android:focusable="true">

          <ImageView
            android:id="@+id/ivGooeyAttachTrigger"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:src="@drawable/ic_gooey_plus"
            app:tint="@color/primary" />
        </FrameLayout>

        <!-- KHUNG Ô NHẬP VIỀN BEAM PHÁT SÁNG RAINBOW GLOW -->
        <com.xiaomi.fixnotification.ai.BorderBeamLayout
          android:id="@+id/layoutInputBeamContainer"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLimiChatInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="Hỏi Limi, gửi ảnh hoặc tài liệu..."
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:maxLines="3"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend" />
        </com.xiaomi.fixnotification.ai.BorderBeamLayout>

        <com.xiaomi.fixnotification.ai.BorderBeamLayout
          android:id="@+id/layoutActionBtnBeam"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_marginStart="4dp">
          
          <com.xiaomi.fixnotification.ai.MetalFxButton
            android:id="@+id/btnLimiChatSend"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        </com.xiaomi.fixnotification.ai.BorderBeamLayout>
      </LinearLayout>

    </LinearLayout>

    <!-- LỚP OVERLAY HIỆU ỨNG LIQUID GOOEY ATTACHMENT (MỞ RỘNG LÊN TRÊN, BẮT TOUCH 100%) -->
    <com.xiaomi.fixnotification.ai.LiquidGooeyAttachmentLayout
      android:id="@+id/layoutGooeyAttach"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:visibility="gone" />
</FrameLayout>
