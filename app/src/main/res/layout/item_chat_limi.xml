<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Avatar Limi AI Logo App -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        app:cardBackgroundColor="@color/button_capsule_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/app_icon" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_chat_bubble_limi"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trợ lý Limi"
                android:textColor="@color/primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCopyAiMessage"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="2dp"
                android:src="@drawable/ic_content_copy"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLimiMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:lineSpacingExtra="3.5dp"
            android:textIsSelectable="true" />

        <!-- Container hiển thị các phân đoạn văn bản và hình ảnh xen kẽ (Rich Sections) -->
        <LinearLayout
            android:id="@+id/layoutLimiRichSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Card hiển thị hình ảnh do Limi AI tìm kiếm hoặc tạo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLimiMessageImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivLimiMessageImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="180dp"
                    android:maxWidth="280dp"
                    android:maxHeight="220dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />

                <!-- Nút / Badge Chạm để phóng to -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_glass_pill"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_fullscreen"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="Chạm để xem ảnh"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card hiển thị icon và thông tin ứng dụng khi hỏi xóa / thao tác app -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAppPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/ivAppPreviewIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_default_app_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppPreviewName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên ứng dụng"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAppPreviewPackage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="com.example.app"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Danh sách Bloatware rác cho phép tích chọn từng app & chọn tất cả -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBloatwareList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Header danh sách: Tiêu đề + Nút Chọn tất cả -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tvBloatwareHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📋 Danh sách Bloatware (Đã chọn: 0)"
                        android:textColor="@color/primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleSelectAllBloat"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="Bỏ chọn tất cả"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        app:rippleColor="#33FF6900" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke"
                    android:layout_marginBottom="4dp" />

                <!-- Container chứa các item app có icon, tên, package và checkbox -->
                <LinearLayout
                    android:id="@+id/layoutBloatwareItemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nút hành động trực tiếp từ Limi AI -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Thanh đánh giá & góp ý câu trả lời AI (Method 2 Feedback Bar) -->
        <LinearLayout
            android:id="@+id/layoutFeedbackBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layoutFeedbackIcons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- NÚT LIKE KÈM SỐ LIKE -->
                <LinearLayout
                    android:id="@+id/btnFeedbackThumbUpContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_feedback_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/btnFeedbackThumbUp"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_thumb_up"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvFeedbackThumbUpCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="0"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- NÚT UNLIKE KÈM SỐ UNLIKE -->
                <LinearLayout
                    android:id="@+id/btnFeedbackThumbDownContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_feedback_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/btnFeedbackThumbDown"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_thumb_down"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvFeedbackThumbDownCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="0"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFeedbackContribute"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_feedback_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivFeedbackContributeIcon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_edit_note"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvFeedbackContributeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="Góp ý"
                        android:textColor="@color/primary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvLimiTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
