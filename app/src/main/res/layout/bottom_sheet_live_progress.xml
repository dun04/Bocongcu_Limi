<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_glass"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="24dp">

    <!-- Thanh kéo Bottom Sheet Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/badge_pill_bg"
        android:backgroundTint="#408E92A0" />

    <!-- Header: Title & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/badge_pill_bg"
            android:backgroundTint="@color/badge_email_bg"
            android:gravity="center"
            android:text="⚡"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProgressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tối Ưu Hóa Hệ Thống"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProgressSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Đang áp dụng cấu hình HyperOS / MIUI..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseProgressSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            android:rotation="-90"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Hero Card: Thanh tiến trình phần trăm -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/glass_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProgressStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Chuẩn bị thực thi..."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/liveProgressBar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:progress="0"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/button_capsule_bg"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Danh sách 4 bước (Step Checklist) -->
    <LinearLayout
        android:id="@+id/containerSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Bước 1 -->
        <LinearLayout
            android:id="@+id/layoutStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_step_card_pending"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/ivStep1Status"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_step_pending" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStep1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bước 1: Fix FCM Socket &amp; Heartbeat"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStep1Desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Làm mới socket kết nối máy chủ Google Push"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bước 2 -->
        <LinearLayout
            android:id="@+id/layoutStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_step_card_pending"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/ivStep2Status"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_step_pending" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStep2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bước 2: Vô hiệu hóa Doze &amp; App Standby"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStep2Desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngăn hệ thống ru ngủ app khi tắt màn hình"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bước 3 -->
        <LinearLayout
            android:id="@+id/layoutStep3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_step_card_pending"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/ivStep3Status"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_step_pending" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStep3Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bước 3: Tắt Wi-Fi Power Save &amp; Greezer"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStep3Desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giữ sóng Wi-Fi liên tục và tắt bộ đóng băng Greezer"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bước 4 -->
        <LinearLayout
            android:id="@+id/layoutStep4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_step_card_pending"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/ivStep4Status"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_step_pending" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStep4Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bước 4: Nạp Millet Whitelist &amp; Sync"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStep4Desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thêm danh sách app không bao giờ bị bóp ngầm"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Mini macOS Terminal Console -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/terminal_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Terminal Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:background="@color/terminal_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/badge_pill_bg"
                    android:backgroundTint="#FF5F56" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/badge_pill_bg"
                    android:backgroundTint="#FFBD2E" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/badge_pill_bg"
                    android:backgroundTint="#27C93F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:text="live_output@hyperos"
                    android:textColor="@color/terminal_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollLiveTerminal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvLiveTerminalOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:text="[System] Khởi động trình thực thi..."
                    android:textColor="@color/terminal_text"
                    android:textSize="10.5sp" />
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Nút điều hướng cuối (Action Buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProgressMinimize"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Ẩn xuống nền"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/button_capsule_bg"
            app:cornerRadius="23dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProgressDone"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@null"
            android:background="@drawable/bg_btn_gradient_orange"
            android:text="Đang xử lý..."
            android:textColor="@color/on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="23dp" />
    </LinearLayout>

</LinearLayout>
