<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/layoutImageViewerRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#FF0D1117"
  android:fitsSystemWindows="false">

  <!-- 1. Ảnh nền làm mờ nghệ thuật (Blurred Background Effect) -->
  <ImageView
    android:id="@+id/ivBlurBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:alpha="0.85" />

  <!-- 2. Lớp phủ tối điện ảnh bảo vệ độ tương phản -->
  <View
    android:id="@+id/viewDarkOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A6000000" />

  <!-- 3. Ảnh chính hỗ trợ cử chỉ vuốt phóng to, thu nhỏ, double tap, vuốt đóng -->
  <com.xiaomi.fixnotification.ai.ZoomableImageView
    android:id="@+id/ivFullPhoto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:clickable="true"
    android:focusable="true" />

  <!-- 4. Nút X (Đóng) ở góc trên bên TRÁI -->
  <FrameLayout
    android:id="@+id/btnCloseImageViewer"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_gravity="top|start"
    android:layout_marginTop="48dp"
    android:layout_marginStart="20dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <ImageView
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:layout_gravity="center"
      android:src="@drawable/ic_close_white"
      app:tint="#FFFFFF" />
  </FrameLayout>

  <!-- 5. Tên nguồn / Domain ở góc dưới bên TRÁI -->
  <TextView
    android:id="@+id/tvImageSource"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_marginStart="24dp"
    android:layout_marginBottom="44dp"
    android:fontFamily="sans-serif"
    android:letterSpacing="0.02"
    android:shadowColor="#80000000"
    android:shadowDx="1"
    android:shadowDy="2"
    android:shadowRadius="4"
    android:text="wikimedia.org"
    android:textColor="#E2E8F0"
    android:textSize="13sp" />

</FrameLayout>
