<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="end"
  android:orientation="vertical"
  android:paddingStart="10dp"
  android:paddingEnd="10dp"
  android:paddingTop="8dp"
  android:paddingBottom="8dp">

  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="40dp"
    android:background="@drawable/bg_chat_bubble_user"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
      android:id="@+id/cardUserMessageImage"
      android:layout_width="180dp"
      android:layout_height="180dp"
      android:layout_marginBottom="6dp"
      android:visibility="gone"
      app:cardCornerRadius="12dp"
      app:cardElevation="0dp"
      app:strokeColor="#40FFFFFF"
      app:strokeWidth="1dp">

      <ImageView
        android:id="@+id/ivUserMessageImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Khung hiển thị nhiều ảnh đính kèm của người dùng (2 - 5 ảnh) -->
    <HorizontalScrollView
      android:id="@+id/scrollUserMultiImages"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="6dp"
      android:visibility="gone"
      android:scrollbars="none">

      <LinearLayout
        android:id="@+id/layoutUserMultiImagesContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
      android:id="@+id/tvUserMessageText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#FFFFFF"
      android:textSize="13.5sp"
      android:lineSpacingExtra="3dp"
      android:textIsSelectable="true" />

    <TextView
      android:id="@+id/tvUserTimestamp"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="end"
      android:layout_marginTop="3dp"
      android:textColor="#FFEDD5"
      android:textSize="9.5sp" />
  </LinearLayout>
</LinearLayout>
